# FYM backend — copy to .env and fill in.
# Never commit the real .env. If secrets were ever committed, rotate them
# in the Supabase / Cloudflare dashboards before anything else.

# ── Supabase (required) ──────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# Service-role key (server only — never ship to the client)
SUPABASE_SECRET_KEY=
# Optional: publishable (anon) key
SUPABASE_PUBLISHABLE_KEY=

# ── Server ───────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins, or * for dev only
CORS_ORIGIN=*

# ── Cloudflare R2 (chat/report media; optional — media routes 503 if unset) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=fymback
R2_PUBLIC_URL=
API_PUBLIC_URL=

# ── Media encryption/signing (optional — derived if unset) ───────────
MEDIA_ENCRYPTION_KEY=
MEDIA_SIGNING_SECRET=

# ── Not yet integrated (Backend Phase 3 / P2) ────────────────────────
# STRIPE_SECRET_KEY=            # or RevenueCat server key when monetization lands
# ADMOB_SSV_SHARED_SECRET=      # bonus-swipes SSV validation
# SENTRY_DSN=
